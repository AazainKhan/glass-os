---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import Logo from './Logo.tsx';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="docs-head">
  <a class="brand" href={`${base}/`} aria-label="Glass home"><Logo /></a>
  <nav class="top" aria-label="Site">
    <a href={`${base}/#features`}>Features</a>
    <a href={`${base}/#try`}>Try it</a>
    <a href={`${base}/#faq`}>FAQ</a>
    <a href={`${base}/overview/`} aria-current="page">Docs</a>
  </nav>
  <div class="tools"><Search /><SocialIcons /><ThemeSelect /></div>
</div>
<style>
  .docs-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 100%; }
  .brand { color: var(--sl-color-white); text-decoration: none; }
  .brand :global(.logo) { display: inline-flex; align-items: center; gap: .55rem; font-weight: 650; font-size: 1.1rem; }
  .top { display: flex; gap: .25rem; }
  .top a { color: var(--sl-color-gray-3); text-decoration: none; padding: .4rem .8rem; border-radius: 999px; font-size: .95rem; }
  .top a:hover, .top a[aria-current] { background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  .tools { display: flex; align-items: center; gap: .75rem; }
  @media (max-width: 800px) { .top { display: none; } }
</style>
<script>
  // "/" opens search, like Cmd or Ctrl+K; the hint sits next to Starlight's own shortcut badge.
  const open = () => document.querySelector<HTMLButtonElement>('button[data-open-modal]');
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !e.metaKey && !e.ctrlKey && !/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) && !t.isContentEditable) { e.preventDefault(); open()?.click(); }
  });
  const badge = open()?.querySelector('kbd');
  if (badge) badge.insertAdjacentHTML('beforebegin', '<kbd class="slash" aria-hidden="true">/</kbd>');
</script>
