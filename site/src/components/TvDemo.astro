---
// Hero screen. If src/assets/hero.png exists it is shown; otherwise an authored illustration
// of a Glass home screen (generic apps, no real brands) stands in and is labelled as such.
import { Image } from 'astro:assets';
const shots = import.meta.glob('../assets/hero.png', { eager: true, import: 'default' });
const hero = Object.values(shots)[0] as ImageMetadata | undefined;
const apps = [
  { n: 'Movies', a: 'oklch(0.55 0.2 20)', b: 'oklch(0.35 0.15 330)' },
  { n: 'Music', a: 'oklch(0.62 0.17 340)', b: 'oklch(0.4 0.17 300)' },
  { n: 'Live', a: 'oklch(0.6 0.13 210)', b: 'oklch(0.36 0.1 250)' },
  { n: 'Games', a: 'oklch(0.7 0.16 150)', b: 'oklch(0.4 0.1 200)' },
  { n: 'Photos', a: 'oklch(0.78 0.14 75)', b: 'oklch(0.55 0.18 30)' },
  { n: 'Browser', a: 'oklch(0.58 0.15 265)', b: 'oklch(0.34 0.13 290)' },
];
const alt = 'Glass home screen on a Fire TV: a top row of app tiles over frosted glass, with a featured shelf below.';
---
<figure class="tv" data-tv>
  <div class="bezel">
    <div class="screen">
      {hero ? (
        <Image src={hero} alt={alt} widths={[800, 1280, 1920]} sizes="(min-width: 900px) 640px, 92vw" loading="eager" />
      ) : (
        <div class="sim" aria-hidden="true">
          <div class="sim-wall"></div>
          <div class="sim-top"><span>Glass</span><span class="sim-clock">9:41</span></div>
          <div class="sim-row">
            {apps.map((t, i) => (
              <div class="tile" data-tile style={`--a:${t.a};--b:${t.b}`} aria-current={i === 1 ? 'true' : undefined}>
                <i></i><b>{t.n}</b>
              </div>
            ))}
          </div>
          <div class="sim-shelf">
            <div class="shelf-card"></div><div class="shelf-card"></div><div class="shelf-card"></div>
          </div>
        </div>
      )}
    </div>
  </div>
  {!hero && <figcaption>Illustration of the Glass home screen. A real capture from the stick is coming soon.</figcaption>}
</figure>
<style>
  .tv { margin: 0; container-type: inline-size; }
  .bezel { padding: 1.1cqw; border-radius: 3cqw; background: linear-gradient(160deg, oklch(0.32 0.03 275), oklch(0.12 0.03 275)); box-shadow: inset 0 1px 0 oklch(1 0 0 / .25), 0 3cqw 8cqw oklch(0.05 0.03 275 / .65), 0 0 0 1px oklch(1 0 0 / .08); }
  .screen { aspect-ratio: 16/9; border-radius: 2.1cqw; overflow: hidden; position: relative; background: var(--ink-1); }
  .screen :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  figcaption { margin-top: 14px; font-size: .85rem; color: var(--text-3); text-align: center; }
  .sim { position: absolute; inset: 0; font-size: 1.9cqw; color: #fff; }
  .sim-wall { position: absolute; inset: 0; background:
    radial-gradient(60% 80% at 15% 20%, oklch(0.55 0.13 205), transparent 70%),
    radial-gradient(55% 70% at 85% 30%, oklch(0.42 0.17 300), transparent 70%),
    radial-gradient(70% 60% at 55% 105%, oklch(0.7 0.14 55), transparent 70%), oklch(0.2 0.05 275); }
  .sim-top { position: absolute; inset: 4cqw 5cqw auto; display: flex; justify-content: space-between; font-weight: 650; opacity: .9; }
  .sim-clock { font-variant-numeric: tabular-nums; opacity: .8; }
  .sim-row { position: absolute; left: 5cqw; right: 5cqw; top: 17cqw; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.6cqw; }
  .tile { aspect-ratio: 16/10; border-radius: 1.6cqw; position: relative; background: linear-gradient(150deg, var(--a), var(--b)); box-shadow: 0 .6cqw 1.4cqw oklch(0.1 0.03 275 / .35), inset 0 .12cqw 0 oklch(1 0 0 / .35);
    transition: transform .9s var(--spring), box-shadow .6s var(--ease); transform-origin: 50% 70%; }
  .tile i { position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(180deg, oklch(1 0 0 / .22), transparent 45%); }
  .tile b { position: absolute; left: 0; right: 0; bottom: -3.2cqw; text-align: center; font-size: 1.5cqw; font-weight: 600; opacity: 0; transition: opacity .4s var(--ease); }
  .tile[aria-current='true'] { transform: translateY(-1.1cqw) scale(1.16) perspective(40cqw) rotateX(3deg); box-shadow: 0 2.2cqw 3.4cqw oklch(0.08 0.03 275 / .55), inset 0 .12cqw 0 oklch(1 0 0 / .5); z-index: 2; }
  .tile[aria-current='true'] b { opacity: 1; }
  .sim-shelf { position: absolute; left: 5cqw; right: 5cqw; bottom: 4.2cqw; height: 15cqw; padding: 1.6cqw; border-radius: 2.4cqw; display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 1.4cqw; background: oklch(1 0 0 / .1); backdrop-filter: blur(1.4cqw) saturate(1.4); border: .1cqw solid oklch(1 0 0 / .22); box-shadow: inset 0 .12cqw 0 oklch(1 0 0 / .32); }
  .shelf-card { border-radius: 1.4cqw; background: linear-gradient(120deg, oklch(1 0 0 / .2), oklch(1 0 0 / .06)); }
  @media (prefers-reduced-motion: reduce) { .tile { transition: none; } }
</style>
<script>
  const tiles = [...document.querySelectorAll<HTMLElement>('[data-tile]')];
  const root = document.querySelector('[data-tv]');
  if (tiles.length && root) {
    let i = tiles.findIndex((t) => t.getAttribute('aria-current') === 'true');
    const set = (n: number) => { i = n; tiles.forEach((t, k) => k === n ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')); };
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    let timer: number | undefined;
    const start = () => { if (calm.matches) return; stop(); timer = window.setInterval(() => set((i + 1) % tiles.length), 2400); };
    const stop = () => { if (timer) window.clearInterval(timer); };
    tiles.forEach((t, k) => t.addEventListener('pointerenter', () => { stop(); set(k); }));
    root.addEventListener('pointerleave', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }
</script>
