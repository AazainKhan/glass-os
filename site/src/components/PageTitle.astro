---
import Icon from './Icon.tsx';
import { SITE, REPO, SECTIONS, pathFor } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { entry } = Astro.locals.starlightRoute;
const { title } = entry.data;
const path = pathFor(entry.id);
const mdUrl = `${SITE}${path}.md`;
const mdHref = `${base}${path}.md`;
const section = SECTIONS[path.split('/')[1]] ?? 'Docs';
const prompt = `Read ${mdUrl} and answer my questions about it. Quote the page when you can.`;
const claude = `https://claude.ai/new?q=${encodeURIComponent(prompt)}`;
const chatgpt = `https://chatgpt.com/?q=${encodeURIComponent(prompt)}`;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <a href={`${base}/`}>Home</a><span aria-hidden="true">/</span><span>{section}</span>
</nav>
<h1 id="_top">{title}</h1>
<div class="actions" role="group" aria-label="Page actions" data-md={mdHref}>
  <button type="button" class="act" data-copy aria-live="polite">
    <span class="ico-copy"><Icon name="Copy" size={16} /></span><span class="ico-done"><Icon name="Check" size={16} /></span>
    <span class="lbl" data-label>Copy for LLM</span>
  </button>
  <a class="act" href={mdHref}><Icon name="FileMd" size={16} />View as Markdown</a>
  <details class="menu">
    <summary class="act"><Icon name="Sparkle" size={16} />Ask about this page<Icon name="CaretDown" size={14} /></summary>
    <div class="pop">
      <a href={claude} target="_blank" rel="noopener"><Icon name="ArrowSquareOut" size={16} />Open in Claude</a>
      <a href={chatgpt} target="_blank" rel="noopener"><Icon name="ArrowSquareOut" size={16} />Open in ChatGPT</a>
    </div>
  </details>
  <details class="menu">
    <summary class="act"><Icon name="Robot" size={16} />Use with agents<Icon name="CaretDown" size={14} /></summary>
    <div class="pop">
      <a href={`${base}/agents/runbook/`}><Icon name="Terminal" size={16} />Agent runbook</a>
      <a href={`${base}/llms.txt`}><Icon name="FileMd" size={16} />llms.txt</a>
    </div>
  </details>
</div>
<style>
  .crumbs { display: flex; gap: .5rem; align-items: center; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); margin-bottom: .75rem; }
  .crumbs a { color: var(--sl-color-gray-3); text-decoration: none; }
  .crumbs a:hover { color: var(--sl-color-white); }
  h1 { margin: 0; font-size: var(--sl-text-h1); line-height: var(--sl-line-height-headings); font-weight: 600; letter-spacing: -0.035em; color: var(--sl-color-white); }
  .actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.25rem; }
  .act { display: inline-flex; align-items: center; gap: .45rem; padding: .45rem .9rem; border-radius: 999px; border: 1px solid var(--sl-color-hairline-light); background: var(--sl-color-gray-7); color: var(--sl-color-gray-2); font: inherit; font-size: var(--sl-text-sm); text-decoration: none; cursor: pointer; list-style: none; transition: background .25s, color .25s, border-color .25s; }
  .act:hover, details[open] > .act { background: var(--sl-color-gray-6); color: var(--sl-color-white); border-color: var(--sl-color-gray-4); }
  summary::-webkit-details-marker { display: none; }
  .menu { position: relative; }
  .pop { position: absolute; z-index: 20; top: calc(100% + .4rem); left: 0; min-width: 14rem; padding: .4rem; display: grid; border-radius: 28px; background: var(--sl-color-gray-7); border: 1px solid var(--sl-color-hairline-light); box-shadow: 0 24px 60px rgba(6, 6, 10, .55); }
  .pop a { display: flex; align-items: center; gap: .6rem; padding: .6rem .9rem; border-radius: 999px; color: var(--sl-color-gray-1); text-decoration: none; font-size: var(--sl-text-sm); }
  .pop a:hover { background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  .ico-done { display: none; }
  [data-copy].done .ico-copy { display: none; } [data-copy].done .ico-done { display: inline-flex; } [data-copy].done { color: var(--sl-color-white); }
  @media (prefers-reduced-motion: reduce) { .act { transition: none; } }
</style>
<script>
  const bar = document.querySelector<HTMLElement>('.actions');
  const btn = bar?.querySelector<HTMLButtonElement>('[data-copy]');
  const label = btn?.querySelector<HTMLElement>('[data-label]');
  btn?.addEventListener('click', async () => {
    try {
      const res = await fetch(bar!.dataset.md!);
      await navigator.clipboard.writeText(await res.text());
      btn.classList.add('done'); label!.textContent = 'Copied';
    } catch { label!.textContent = 'Copy failed'; }
    setTimeout(() => { btn.classList.remove('done'); label!.textContent = 'Copy for LLM'; }, 2000);
  });
  // Close open menus on outside click or Escape.
  document.addEventListener('click', (e) => document.querySelectorAll<HTMLDetailsElement>('.actions details[open]').forEach((d) => { if (!d.contains(e.target as Node)) d.open = false; }));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') document.querySelectorAll<HTMLDetailsElement>('.actions details[open]').forEach((d) => (d.open = false)); });
</script>
