---
import Icon from './Icon.tsx';
import { SITE, REPO, SECTIONS, pathFor } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { entry } = Astro.locals.starlightRoute;
const { title } = entry.data;
const path = pathFor(entry.id);
const mdUrl = `${SITE}${path}.md`;
const mdHref = `${base}${path}.md`;
const section = SECTIONS[path.split('/')[1]] ?? 'Docs';
const prompt = `Read ${mdUrl} and answer my questions about it. Quote the page when you can.`;
const claude = `https://claude.ai/new?q=${encodeURIComponent(prompt)}`;
const chatgpt = `https://chatgpt.com/?q=${encodeURIComponent(prompt)}`;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <a href={`${base}/`}>Home</a><span aria-hidden="true">/</span><span>{section}</span>
</nav>
<h1 id="_top">{title}</h1>
<div class="actions" role="group" aria-label="Page actions" data-md={mdHref}>
  <div class="split">
    <button type="button" class="seg main" data-copy aria-live="polite" aria-label="Copy page as Markdown">
      <span class="ico-copy"><Icon name="Copy" size={16} /></span><span class="ico-done"><Icon name="Check" size={16} /></span>
      <span class="lbl" data-label>Copy page</span>
    </button>
    <button type="button" class="seg caret" data-toggle aria-haspopup="true" aria-expanded="false" aria-controls="page-actions-menu" aria-label="More page actions">
      <Icon name="CaretDown" size={16} />
    </button>
    <div class="pop" id="page-actions-menu" hidden>
      <a href={mdHref}><Icon name="FileMd" size={16} />View as Markdown</a>
      <a href={claude} target="_blank" rel="noopener"><Icon name="Sparkle" size={16} />Ask Claude about this page</a>
      <a href={chatgpt} target="_blank" rel="noopener"><Icon name="ArrowSquareOut" size={16} />Ask ChatGPT about this page</a>
      <hr />
      <p class="grp">Use with agents</p>
      <a href={`${base}/agents/runbook/`}><Icon name="Terminal" size={16} />Agent runbook</a>
      <a href={`${base}/llms.txt`}><Icon name="Robot" size={16} />llms.txt</a>
    </div>
  </div>
</div>
<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); margin-bottom: .75rem; }
  .crumbs a { color: var(--sl-color-gray-3); text-decoration: none; }
  .crumbs a:hover { color: var(--sl-color-white); }
  h1 { margin: 0; font-size: var(--sl-text-h1); line-height: var(--sl-line-height-headings); font-weight: 600; letter-spacing: -0.035em; color: var(--sl-color-white); overflow-wrap: anywhere; }
  .actions { margin-top: 1rem; }
  .split { position: relative; display: inline-flex; align-items: stretch; height: 2rem; }
  .seg { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; height: 100%; padding: 0 .7rem; border: 1px solid var(--sl-color-hairline-light); background: var(--sl-color-gray-7); color: var(--sl-color-gray-2); font: inherit; font-size: .8125rem; line-height: 1; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .seg.main { border-radius: 8px 0 0 8px; }
  .seg.caret { width: 2rem; padding: 0; margin-inline-start: -1px; border-radius: 0 8px 8px 0; }
  .seg:hover, .seg[aria-expanded='true'] { background: var(--sl-color-gray-6); color: var(--sl-color-white); border-color: var(--sl-color-gray-4); position: relative; z-index: 1; }
  .seg:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; z-index: 2; position: relative; }
  .seg.caret :global(svg) { transition: transform .2s; }
  .seg.caret[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  .pop { position: absolute; z-index: 20; top: calc(100% + .375rem); left: 0; width: max-content; min-width: 15rem; max-width: calc(100vw - 2rem); padding: .3rem; display: grid; border-radius: 14px; background: var(--sl-color-gray-7); border: 1px solid var(--sl-color-hairline-light); box-shadow: 0 16px 40px rgba(6, 6, 10, .3); }
  .pop[hidden] { display: none; }
  .pop a { display: flex; align-items: center; gap: .6rem; padding: .45rem .65rem; border-radius: 9px; color: var(--sl-color-gray-1); text-decoration: none; font-size: .8125rem; }
  .pop a:hover, .pop a:focus-visible { background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  .pop a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: -2px; }
  .pop hr { border: 0; border-top: 1px solid var(--sl-color-hairline); margin: .3rem .2rem; }
  .grp { margin: 0; padding: .25rem .65rem; font-size: .6875rem; text-transform: uppercase; letter-spacing: .06em; color: var(--sl-color-gray-3); }
  .ico-done { display: none; }
  [data-copy].done .ico-copy { display: none; } [data-copy].done .ico-done { display: inline-flex; } [data-copy].done { color: var(--sl-color-white); }
  @media (max-width: 640px) {
    .seg.main { padding: 0; width: 2rem; }
    .lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) { .seg, .seg.caret :global(svg) { transition: none; } }
</style>
<script>
  const bar = document.querySelector<HTMLElement>('.actions');
  const btn = bar?.querySelector<HTMLButtonElement>('[data-copy]');
  const label = btn?.querySelector<HTMLElement>('[data-label]');
  const toggle = bar?.querySelector<HTMLButtonElement>('[data-toggle]');
  const pop = bar?.querySelector<HTMLElement>('.pop');
  btn?.addEventListener('click', async () => {
    try {
      const res = await fetch(bar!.dataset.md!);
      await navigator.clipboard.writeText(await res.text());
      btn.classList.add('done'); label!.textContent = 'Copied';
    } catch { label!.textContent = 'Copy failed'; }
    setTimeout(() => { btn.classList.remove('done'); label!.textContent = 'Copy page'; }, 2000);
  });
  const setOpen = (open: boolean, refocus = false) => {
    if (!toggle || !pop) return;
    pop.hidden = !open; toggle.setAttribute('aria-expanded', String(open));
    if (!open && refocus) toggle.focus();
  };
  toggle?.addEventListener('click', () => setOpen(pop!.hidden));
  const items = () => [...(pop?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
  document.addEventListener('click', (e) => { if (pop && !pop.hidden && !bar!.contains(e.target as Node)) setOpen(false); });
  bar?.addEventListener('focusout', (e) => { if (pop && !pop.hidden && !bar.contains(e.relatedTarget as Node)) setOpen(false); });
  bar?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && pop && !pop.hidden) { e.preventDefault(); setOpen(false, true); }
    if (e.key === 'ArrowDown' && e.target === toggle) { e.preventDefault(); setOpen(true); items()[0]?.focus(); }
    if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && pop?.contains(e.target as Node)) {
      e.preventDefault(); const l = items(); const i = l.indexOf(e.target as HTMLAnchorElement);
      l[(i + (e.key === 'ArrowDown' ? 1 : l.length - 1)) % l.length].focus();
    }
  });
</script>
