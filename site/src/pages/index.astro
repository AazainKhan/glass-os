---
import '../styles/glass.css';
import SiteNav from '../components/SiteNav.astro';
import TvDemo from '../components/TvDemo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = 'https://github.com/AazainKhan/glass-tv-launcher/releases';
const repo = 'https://github.com/AazainKhan/glass-tv-launcher';

const qr = Array.from({ length: 25 }, (_, i) => [0,1,2,4,5,6,10,12,14,16,18,20,21,22,24,7,17,19,23].includes(i) ? 1 : 0);
const tiers = [
  { n: 'Tier 0', name: 'APK only', status: 'Available', tone: 'ok', need: 'The remote and a way to sideload (Downloader works).', does: 'Installs Glass. An accessibility toggle bounces Amazon’s home away.', undo: 'Toggle off, uninstall.', href: `${base}/install/tier-0-apk/` },
  { n: 'Tier 1', name: 'APK + one adb command', status: 'Available', tone: 'ok', need: 'Tier 0 plus a computer with adb.', does: 'Disables Amazon’s launcher so Home is Glass. Optional permission grants.', undo: 'One adb command.', href: `${base}/install/tier-1-adb/` },
  { n: 'Tier 2', name: 'Glass Pro', status: 'Coming soon', tone: 'soon', need: 'A rooted stick running Magisk.', does: 'Remote-button remap, memory tuning, Glass as a system app, systemless debloat.', undo: 'Uninstall the module.', href: `${base}/install/tier-2-glass-pro/` },
  { n: 'Tier 3', name: 'Glass OS', status: 'In development', tone: 'dev', need: 'Unlocked bootloader, custom recovery, your own OTA file.', does: 'A rebuilt system image with Amazon’s launcher and bloat removed.', undo: 'Flash your backup.', href: `${base}/install/tier-3-glass-os/` },
];
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Glass: an Apple TV–style home screen for Fire TV</title>
    <meta name="description" content="Glass is a free, open-source launcher for Fire TV and Android TV with an Apple TV–style look. Frosted glass, spring focus, and install paths from a plain APK up to a custom image." />
    <meta name="theme-color" content="#0d0b1c" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href={`${base}/llms.txt`} title="llms.txt" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body>
    <div class="wall" aria-hidden="true"><i></i><i></i><i></i></div>
    <SiteNav />

    <main>
      <section class="hero">
        <div class="hero-copy" data-reveal="rise">
          <h1>A calmer home screen for your Fire&nbsp;TV.</h1>
          <p class="lede">Glass is a free, open-source launcher with an Apple TV–style look: frosted glass, a top row of your apps, and focus that moves the way your thumb expects. Built to stay smooth on a cheap stick.</p>
          <div class="actions">
            <a class="btn primary" href={releases}>Download the APK</a>
            <a class="btn ghost" href="#tiers">Pick your install tier</a>
          </div>
          <p class="fine">Free · Apache-2.0 · Android 9+ · Tested on the Fire TV Stick 4K (2nd gen) only</p>
        </div>
        <div class="hero-tv" data-reveal="settle"><TvDemo /></div>
      </section>

      <section id="features" class="section">
        <div class="head" data-reveal="rise">
          <h2>What you get</h2>
          <p>Three things Glass does that stock home screens do not, then the rest of the list.</p>
        </div>

        <article class="feature" data-reveal="settle">
          <div class="f-copy">
            <h3>Glass that stays fast</h3>
            <p>Android 12’s blur APIs are not available on a Fire Stick, so Glass blurs the wallpaper once and maps that one backdrop under every glass surface in a single GPU pass. On the Fire TV Stick 4K (2nd gen) that measured under 1% janky frames, and roughly 0% CPU when idle.</p>
          </div>
          <div class="f-art art-glass" aria-hidden="true"><span></span><span></span><span></span></div>
        </article>

        <article class="feature flip" data-reveal="settle">
          <div class="f-copy">
            <h3>Focus that feels right</h3>
            <p>Apps lift and scale on a spring, tilt in from the direction you pressed, and cast a softer shadow as they rise. The label appears under the one you are on. Apps without a TV banner get a generated full-bleed tile, so nothing looks like a stray square.</p>
          </div>
          <div class="f-art art-focus" aria-hidden="true"><b></b><b></b><b class="on"></b><b></b></div>
        </article>

        <article class="feature" data-reveal="settle">
          <div class="f-copy">
            <h3>Set up from your phone</h3>
            <p>Scan a QR code and type API keys, URLs and names on your phone instead of with the remote. The form is served only on your local network, on a one-time link, while the panel is open.</p>
          </div>
          <div class="f-art art-phone" aria-hidden="true"><div>{qr.map((on) => <u class={on ? 'on' : undefined}></u>)}</div></div>
        </article>

        <div class="also" data-reveal="rise">
          <h3>Also in the box</h3>
          <dl>
            <div><dt>Top row and folders</dt><dd>Up to six apps on a glass shelf, folders with a blurred backdrop, move and hide anything, custom icons and icon packs.</dd></div>
            <div><dt>A featured shelf</dt><dd>From Stremio, TMDB (your free key), YouTube trending (your key) or Plex On Deck. Selecting an item opens the matching app.</dd></div>
            <div><dt>Aerial screensaver</dt><dd>Apple’s Aerial videos, cached for offline replay. Fire OS only runs Amazon’s screensavers, so Glass starts Aerials from its own idle timer there.</dd></div>
            <div><dt>Burn-in care</dt><dd>The clock, status bar and shelf fade when idle, and the screen drifts a few pixels each minute.</dd></div>
            <div><dt>Wallpapers and widgets</dt><dd>Gradients or your own image, separate light and dark. Clock, weather, and Now Playing from any media app.</dd></div>
            <div><dt>Accessibility</dt><dd>Reduce Motion and Reduce Transparency, following the system settings by default. Large 10-foot type.</dd></div>
            <div><dt>Updates and backup</dt><dd>In-app updates from GitHub Releases, plus backup and restore of your layout.</dd></div>
          </dl>
        </div>
      </section>

      <section id="how" class="section">
        <div class="head" data-reveal="rise">
          <h2>How it works</h2>
          <p>Glass is a normal app that asks to be your home screen. How firmly depends on how far you want to go.</p>
        </div>
        <ol class="steps">
          <li data-reveal="settle">
            <span class="num">1</span>
            <h3>Sideload the APK</h3>
            <p>Download it from the releases page and install it, for example with the Downloader app.</p>
          </li>
          <li data-reveal="settle">
            <span class="num">2</span>
            <h3>Make it home</h3>
            <p>Turn on <em>Home Button Takeover</em> in Glass and it will bounce Amazon’s launcher out of the way. For a clean takeover, run this from a computer:</p>
            <pre><code>adb shell pm disable-user --user 0 com.amazon.tv.launcher</code></pre>
          </li>
          <li data-reveal="settle">
            <span class="num">3</span>
            <h3>Undo it any time</h3>
            <p>Turn the toggle off and uninstall, or bring Amazon’s launcher back:</p>
            <pre><code>adb shell pm enable com.amazon.tv.launcher</code></pre>
          </li>
        </ol>
        <p class="note" data-reveal="rise">Why not just take over Home? Fire OS handles the Home button before any app sees it, so without root the best an app can do is get out of the way. The <a href={`${base}/no-root/`}>no-root page</a> lists exactly what works and what does not.</p>
      </section>

      <section id="tiers" class="section">
        <div class="head" data-reveal="rise">
          <h2>Choose how deep to go</h2>
          <p>Most people stop at Tier 1. The deeper tiers are for tinkerers with a rooted or unlocked stick, and they are not released yet.</p>
        </div>
        <div class="tiers">
          {tiers.map((t) => (
            <a class={`tier ${t.tone}`} href={t.href} data-reveal="settle">
              <div class="tier-top"><span class="tn">{t.n}</span><span class={`pill ${t.tone}`}>{t.status}</span></div>
              <h3>{t.name}</h3>
              <p>{t.does}</p>
              <dl>
                <div><dt>You need</dt><dd>{t.need}</dd></div>
                <div><dt>Undo</dt><dd>{t.undo}</dd></div>
              </dl>
              <span class="go">{t.tone === 'ok' ? 'Install guide' : 'Read the plan'} <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M4 10h11m-4-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </a>
          ))}
        </div>
      </section>

      <section class="section upfront">
        <div class="head" data-reveal="rise"><h2>What we are upfront about</h2></div>
        <ul>
          <li data-reveal="settle"><strong>One tested device.</strong> The Fire TV Stick 4K (2nd gen) is the only hardware Glass has been checked on. Others should work; <a href={`${repo}/issues/new?template=device_report.yml`}>tell us how it runs</a>.</li>
          <li data-reveal="settle"><strong>TV only.</strong> It is built for a D-pad remote at 1080p. There is no touch or mouse support.</li>
          <li data-reveal="settle"><strong>Root features stay hidden without root.</strong> Continue Watching, Fire TV app art and memory tuning appear only on a rooted stick.</li>
        </ul>
      </section>

      <section class="section close" data-reveal="settle">
        <div class="close-panel">
          <h2>Try it tonight. Undo it in a minute.</h2>
          <p>Tiers 0 and 1 change nothing that an uninstall plus one command does not reverse.</p>
          <div class="actions">
            <a class="btn primary" href={releases}>Download the APK</a>
            <a class="btn ghost" href={`${base}/install/`}>Read the install guide</a>
          </div>
          <p class="agent">Prefer to hand it over? <a href={`${base}/agents/runbook/`}>An agent can follow the runbook</a> with you approving each write. Index for agents: <a href={`${base}/llms.txt`}>llms.txt</a>.</p>
        </div>
      </section>
    </main>

    <footer>
      <p>Glass TV Launcher is open source under Apache-2.0 and is not affiliated with Apple, Amazon or Google.</p>
      <nav aria-label="Footer">
        <a href={repo}>GitHub</a>
        <a href={releases}>Releases</a>
        <a href={`${base}/overview/`}>Docs</a>
        <a href={`${base}/troubleshooting/`}>Troubleshooting</a>
        <a href={`${base}/contributing/`}>Contributing</a>
      </nav>
    </footer>

    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (calm || !('IntersectionObserver' in window)) {
        els.forEach((e) => e.classList.add('in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { (en.target as HTMLElement).classList.add('in'); io.unobserve(en.target); } });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
        els.forEach((e, i) => { e.style.setProperty('--d', `${(i % 4) * 70}ms`); io.observe(e); });
      }
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 90px; color-scheme: dark; }
  body { margin: 0; background: var(--ink-0); color: var(--text); font-family: var(--font); font-size: 1.0625rem; line-height: 1.6; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration-color: oklch(1 0 0 / .35); text-underline-offset: .22em; }
  ::selection { background: oklch(0.76 0.14 58 / .45); color: #fff; }
  :focus-visible { outline: 2px solid var(--ember); outline-offset: 3px; border-radius: 8px; }
  h1, h2, h3 { margin: 0; line-height: 1.08; letter-spacing: -0.03em; text-wrap: balance; }
  p { margin: 0; text-wrap: pretty; }
  main { position: relative; z-index: 1; overflow-x: clip; }

  /* wallpaper */
  .wall { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: var(--ink-0); }
  .wall i { position: absolute; width: 90vmax; height: 90vmax; border-radius: 50%; will-change: transform; }
  .wall i:nth-child(1) { left: -35vmax; top: -40vmax; background: radial-gradient(closest-side, oklch(0.5 0.12 205 / .75), transparent); animation: d1 38s ease-in-out infinite alternate; }
  .wall i:nth-child(2) { right: -40vmax; top: -10vmax; background: radial-gradient(closest-side, oklch(0.42 0.17 296 / .8), transparent); animation: d2 46s ease-in-out infinite alternate; }
  .wall i:nth-child(3) { left: 5vmax; bottom: -65vmax; background: radial-gradient(closest-side, oklch(0.7 0.13 55 / .5), transparent); animation: d3 52s ease-in-out infinite alternate; }
  @keyframes d1 { to { transform: translate3d(12vmax, 8vmax, 0); } }
  @keyframes d2 { to { transform: translate3d(-14vmax, 10vmax, 0); } }
  @keyframes d3 { to { transform: translate3d(8vmax, -8vmax, 0); } }

  /* reveal */
  .js [data-reveal] { opacity: 0; transition: opacity .9s var(--ease) var(--d, 0ms), transform 1s var(--ease) var(--d, 0ms), filter .9s var(--ease) var(--d, 0ms); }
  .js [data-reveal='rise'] { transform: translateY(26px); }
  .js [data-reveal='settle'] { transform: translateY(18px) scale(.97); filter: blur(6px); }
  .js [data-reveal].in { opacity: 1; transform: none; filter: none; }

  /* layout */
  .hero, .section, footer { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
  .hero { min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.22fr); gap: clamp(28px, 4vw, 56px); align-items: center; padding: 120px 0 56px; }
  h1 { font-size: clamp(2.5rem, 5.4vw, 4.4rem); font-weight: 750; }
  .lede { margin-top: 22px; font-size: clamp(1.08rem, 1.6vw, 1.28rem); color: var(--text-2); max-width: 34em; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .btn { display: inline-flex; align-items: center; padding: 14px 26px; border-radius: 999px; font-weight: 650; text-decoration: none; transition: transform .6s var(--spring), background .25s, box-shadow .4s var(--ease); }
  .btn:hover { transform: translateY(-2px) scale(1.04); }
  .btn:active { transform: scale(.98); transition-duration: .15s; }
  .btn.primary { background: var(--text); color: var(--ink-0); box-shadow: 0 10px 30px oklch(0.76 0.14 58 / .25); }
  .btn.ghost { background: var(--glass); border: 1px solid var(--glass-line); box-shadow: inset 0 1px 0 var(--glass-shine); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
  .btn.ghost:hover { background: var(--glass-hi); }
  .fine { margin-top: 22px; font-size: .88rem; color: var(--text-3); }

  .section { padding: clamp(72px, 11vw, 140px) 0 0; position: relative; }
  .section::before { content: ''; position: absolute; z-index: -1; inset: 0 -15vw; pointer-events: none; background: radial-gradient(50% 45% at 10% 40%, oklch(0.45 0.11 205 / .35), transparent 70%); }
  #how::before { background: radial-gradient(45% 40% at 90% 30%, oklch(0.42 0.16 296 / .45), transparent 70%); }
  #tiers::before { background: radial-gradient(50% 40% at 15% 60%, oklch(0.62 0.13 58 / .28), transparent 70%), radial-gradient(45% 40% at 95% 20%, oklch(0.42 0.15 296 / .35), transparent 70%); }
  .close::before { background: radial-gradient(60% 55% at 50% 60%, oklch(0.5 0.12 205 / .4), transparent 70%); }
  .head { max-width: 40rem; margin-bottom: clamp(36px, 5vw, 64px); }
  h2 { font-size: clamp(2rem, 4.4vw, 3.4rem); font-weight: 720; }
  .head p { margin-top: 16px; color: var(--text-2); font-size: 1.12rem; }
  h3 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); font-weight: 700; }

  .feature, .also, .tier, .steps li, .upfront li, .close-panel {
    background: var(--glass); border: 1px solid var(--glass-line); border-radius: var(--r-panel);
    box-shadow: inset 0 1px 0 var(--glass-shine), 0 24px 60px oklch(0.05 0.03 275 / .35);
    -webkit-backdrop-filter: blur(20px) saturate(1.4); backdrop-filter: blur(20px) saturate(1.4);
  }
  .feature { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(20px, 4vw, 56px); align-items: center; padding: clamp(24px, 4vw, 52px); margin-bottom: 22px; }
  .feature.flip .f-copy { order: 2; }
  .f-copy p { margin-top: 16px; color: var(--text-2); max-width: 32em; }
  .f-art { aspect-ratio: 4/3; position: relative; border-radius: 22px; overflow: hidden; background: oklch(0.14 0.04 275 / .6); }

  .art-glass { background: radial-gradient(70% 80% at 20% 25%, oklch(0.6 0.14 205), transparent 70%), radial-gradient(60% 70% at 85% 80%, oklch(0.7 0.14 55), transparent 70%), oklch(0.25 0.1 290); }
  .art-glass span { position: absolute; border-radius: 22px; background: oklch(1 0 0 / .1); border: 1px solid oklch(1 0 0 / .25); box-shadow: inset 0 1px 0 oklch(1 0 0 / .4); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); transition: transform 1.2s var(--spring); }
  .art-glass span:nth-child(1) { inset: 12% 28% 38% 8%; }
  .art-glass span:nth-child(2) { inset: 30% 8% 18% 36%; background: oklch(1 0 0 / .14); }
  .art-glass span:nth-child(3) { inset: 62% 40% 8% 14%; border-radius: 16px; }
  .feature:hover .art-glass span:nth-child(1) { transform: translate(-3%, -3%); }
  .feature:hover .art-glass span:nth-child(2) { transform: translate(3%, 2%); }
  .feature:hover .art-glass span:nth-child(3) { transform: translate(-2%, 4%); }

  .art-focus { display: flex; align-items: center; justify-content: center; gap: 4%; background: radial-gradient(80% 70% at 50% 120%, oklch(0.5 0.17 300), transparent 70%), oklch(0.18 0.05 275); }
  .art-focus b { width: 19%; aspect-ratio: 3/4; border-radius: 14px; background: linear-gradient(150deg, oklch(0.6 0.15 240), oklch(0.38 0.12 285)); box-shadow: 0 6px 14px oklch(0.05 0.03 275 / .4); transition: transform 1s var(--spring), box-shadow .6s var(--ease); }
  .art-focus b:nth-child(1) { background: linear-gradient(150deg, oklch(0.62 0.17 20), oklch(0.4 0.14 340)); }
  .art-focus b:nth-child(3) { background: linear-gradient(150deg, oklch(0.78 0.14 75), oklch(0.55 0.17 35)); }
  .art-focus b:nth-child(4) { background: linear-gradient(150deg, oklch(0.68 0.15 160), oklch(0.4 0.1 205)); }
  .art-focus b.on { transform: translateY(-8%) scale(1.22); box-shadow: 0 22px 30px oklch(0.05 0.03 275 / .6), inset 0 1px 0 oklch(1 0 0 / .5); }
  .feature.flip:hover .art-focus b { transform: scale(1.1) translateY(-4%); }
  .feature.flip:hover .art-focus b.on { transform: translateY(-9%) scale(1.3); }

  .art-phone { display: grid; place-items: center; background: radial-gradient(70% 70% at 50% 0%, oklch(0.45 0.12 205), transparent 70%), oklch(0.18 0.05 275); }
  .art-phone > div { width: 34%; aspect-ratio: 9/18; border-radius: 22px; border: 3px solid oklch(1 0 0 / .55); background: oklch(0.12 0.03 275); display: grid; grid-template-columns: repeat(5, 1fr); gap: 4%; padding: 16% 12%; align-content: center; transition: transform 1.2s var(--spring); }
  .feature:hover .art-phone > div { transform: rotate(-4deg) translateY(-3%); }
  .art-phone u { aspect-ratio: 1; border-radius: 3px; background: oklch(1 0 0 / .08); }
  .art-phone u.on { background: var(--text); }

  .also { padding: clamp(24px, 4vw, 52px); margin-top: 22px; }
  .also h3 { margin-bottom: 24px; }
  .also dl { margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px 48px; }
  .also dt { font-weight: 700; }
  .also dd { margin: 4px 0 0; color: var(--text-2); font-size: .98rem; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .steps li { padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .num { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--text); color: var(--ink-0); font-weight: 750; font-variant-numeric: tabular-nums; }
  .steps p { color: var(--text-2); font-size: .98rem; }
  pre { margin: 6px 0 0; padding: 14px 16px; border-radius: 14px; background: oklch(0.1 0.03 275 / .7); border: 1px solid oklch(1 0 0 / .1); white-space: pre-wrap; overflow-wrap: anywhere; font-size: .82rem; line-height: 1.5; }
  code { font-family: var(--mono); }
  .note { margin-top: 24px; max-width: 46rem; color: var(--text-2); }
  .note a { color: var(--text); }

  .tiers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .tier { display: flex; flex-direction: column; gap: 12px; padding: 26px; text-decoration: none; transition: transform .7s var(--spring), background .3s, box-shadow .5s var(--ease); }
  .tier:hover, .tier:focus-visible { transform: translateY(-6px) scale(1.02); background: var(--glass-hi); box-shadow: inset 0 1px 0 var(--glass-shine), 0 34px 70px oklch(0.05 0.03 275 / .5); }
  .tier.soon, .tier.dev { background: oklch(1 0 0 / .045); }
  .tier-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .tn { font-weight: 650; color: var(--text-3); }
  .pill { padding: 3px 12px; border-radius: 999px; font-size: .78rem; font-weight: 650; border: 1px solid oklch(1 0 0 / .2); }
  .pill.ok { background: oklch(0.72 0.15 160 / .22); color: oklch(0.9 0.1 160); }
  .pill.soon { background: oklch(0.76 0.14 58 / .18); color: oklch(0.9 0.09 70); }
  .pill.dev { background: oklch(0.62 0.17 12 / .2); color: oklch(0.88 0.08 20); }
  .tier h3 { font-size: 1.35rem; }
  .tier > p { color: var(--text-2); font-size: .97rem; }
  .tier dl { margin: 0; display: grid; gap: 10px; font-size: .9rem; }
  .tier dt { color: var(--text-3); font-size: .78rem; font-weight: 650; letter-spacing: .02em; text-transform: uppercase; }
  .tier dd { margin: 2px 0 0; color: var(--text-2); }
  .go { margin-top: auto; padding-top: 6px; display: inline-flex; align-items: center; gap: 6px; font-weight: 650; }
  .go svg { transition: transform .5s var(--spring); }
  .tier:hover .go svg { transform: translateX(5px); }

  .upfront ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
