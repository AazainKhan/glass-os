---
import '../styles/tokens.css';
import '../styles/landing.css';
import QRCode from 'qrcode';
import { siNetflix, siHbomax, siPlex, siYoutube, siStremio, siKodi, siJellyfin, siTwitch, siSpotify } from 'simple-icons';
import Nav from '../components/Nav.astro';
import Icon from '../components/Icon.tsx';
import Logo from '../components/Logo.tsx';
import Hero from '../components/Hero.tsx';
import ScaleUp from '../components/ScaleUp.tsx';
import TryIt from '../components/TryIt.tsx';
import Bento from '../components/Bento.tsx';
import Setup from '../components/Setup.tsx';
import Faq from '../components/Faq.tsx';
import SmoothScroll from '../components/SmoothScroll.tsx';
import Slot from '../components/Slot.tsx';
import { media } from '../lib/media';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://aazainkhan.github.io/glass-os';
const install = `${base}/install/`;
const repo = 'https://github.com/AazainKhan/glass-tv-launcher';

const qr = await QRCode.toString(`${site}/install/`, { type: 'svg', margin: 1, color: { dark: '#0a0a0b', light: '#ededea' } });

const brands = [siNetflix, siHbomax, siPlex, siYoutube, siStremio, siKodi, siJellyfin, siTwitch, siSpotify];

const ways = [
  { name: 'Install the app', who: 'Anyone with a Fire TV, Android TV or Google TV.', need: 'The remote and a way to sideload, such as Downloader.', get: 'Glass on your TV. On Fire TV an accessibility toggle brings it back over Amazon’s home.', status: 'Recommended', href: `${base}/install/app/` },
  { name: 'Install + one command', who: 'Fire TV owners who want no flash of Amazon’s home.', need: 'The above, plus a computer with adb.', get: 'One adb command makes Glass the real home screen. Optional grants unlock a few extras.', status: 'Available', href: `${base}/install/app-plus-adb/` },
  { name: 'Rooted install', who: 'Tinkerers with a rooted Fire TV Stick 4K.', need: 'Magisk.', get: 'One module: built-in system app, remote buttons, Control Center over apps, memory tuning.', status: 'Coming soon', href: `${base}/install/rooted/` },
  { name: 'Full system install', who: 'People who want Amazon’s bloat gone.', need: 'An unlocked bootloader, a custom recovery and your own OTA file.', get: 'A rebuilt Fire OS image with Glass built in.', status: 'In development', href: `${base}/install/full-system/` },
];

const faq = [
  { q: 'Which devices does it run on?', a: 'Glass needs Android 9 or newer. It is tested on the Fire TV Stick 4K (2nd gen) only. Other Fire TV, Android TV and Google TV devices should work, but nobody has verified that yet.' },
  { q: 'Is it on a store, or do I sideload it?', a: 'You sideload it. Download the APK from the GitHub releases page and install it with an app such as Downloader. Updates come from the same releases page, inside the app.' },
  { q: 'Does it replace the stock launcher?', a: 'On Google TV and Android TV you can make Glass the default in Settings. Fire OS has no default picker, so Glass either brings itself back over Amazon’s home or you disable Amazon’s launcher with one adb command. Both are reversible.' },
  { q: 'What permissions does it need?', a: 'Everything works without the optional grants. They are one adb command each: secure settings for the screensaver, usage access for the full recent-apps list, and location for the Wi-Fi name. The phone setup form is served only on your local network, on a one-time link.' },
  { q: 'Is it smooth on low-end hardware?', a: 'It is built for that. Glass blurs the wallpaper once and reuses it under every glass surface. On a Fire TV Stick 4K it cold starts in about half a second, with under 1% janky frames while you browse.' },
];

const m = {
  hero: media('hero-loop'), scene: media('scale-scene'), dock: media('dock'), featured: media('featured'), remote: media('remote-focus'),
  fin: media('final-loop'), demo: media('demo-full'),
  dockIcons: [1, 2, 3, 4, 5].map((i) => media(`dock-${i}`)),
  shelf: [1, 2, 3].map((i) => media(`shelf-${i}`)),
  prev: [1, 2, 3, 4].map((i) => media(`preview-${i}`)),
  themes: [1, 2, 3, 4, 5].map((i) => media(`theme-${i}`)),
};
const setup = [
  { title: 'Install it.', lines: ['Download the APK and sideload it with Downloader.', 'Android 9 or newer.'], m: media('setup-install'), todo: 'install capture', alt: 'Sideloading the Glass APK' },
  { title: 'Set it as home.', lines: ['Turn on Home Button Takeover, or run one adb command.', 'Undo it any time with one command.'], m: media('setup-home'), todo: 'set-as-home capture', alt: 'Making Glass the home screen' },
  { title: 'Make it yours.', lines: ['Rearrange the dock, pick wallpapers and widgets.', 'Type API keys on your phone, not with the remote.'], m: media('setup-customise'), todo: 'customise capture', alt: 'Customising Glass' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Glass: an Apple TV-style home screen for Fire TV</title>
    <meta name="description" content="Glass is a free, open-source launcher for Fire TV and Android TV with an Apple TV-style look. Dock, featured titles and spring focus, built for the remote." />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href={`${base}/llms.txt`} title="llms.txt" />
  </head>
  <body>
    <SmoothScroll client:load />
    <Nav />
    <main>
      <Hero client:load hero={m.hero} demo={m.demo} install={install} />

      <ScaleUp client:load scene={m.scene} />

      <section id="try" class="sec try">
        <div class="wrap">
          <h2>Pick up the remote.</h2>
          <p class="sub">Arrow keys move focus. Enter opens. Escape leaves.</p>
          <TryIt client:visible dock={m.dockIcons} shelf={m.shelf} previews={m.prev} />
        </div>
      </section>

      <section id="features" class="sec">
        <div class="wrap">
          <h2>Everything the home screen needs.</h2>
          <Bento client:visible dock={m.dock} featured={m.featured} themes={m.themes} remote={m.remote} />
        </div>
      </section>

      <section class="sec apps">
        <div class="wrap"><h2>Your apps, all here.</h2></div>
        <div class="marquee" aria-label="Apps you can open from Glass">
          <ul class="track">
            {[0, 1].map((k) => brands.map((b) => (
              <li aria-hidden={k === 1 ? 'true' : undefined}><svg viewBox="0 0 24 24" role="img" aria-label={k === 0 ? b.title : undefined}><path d={b.path} fill="currentColor" /></svg></li>
            )))}
          </ul>
        </div>
        <p class="wrap fine">Glass opens any app installed on your stick. Logos belong to their owners.</p>
      </section>

      <section class="sec setup">
        <div class="wrap"><h2>Set up in a minute.</h2></div>
        <Setup client:load panels={setup} />
      </section>

      <section id="ways" class="sec">
        <div class="wrap">
          <h2>Four ways to install.</h2>
          <p class="sub">One app. Start with the first.</p>
          <ul class="ways">
            {ways.map((w, i) => (
              <li class={i === 0 ? 'way default' : 'way'}>
                <a href={w.href}>
                  <div class="way-head"><h3>{w.name}</h3><span class={`tag ${i === 0 ? 'rec' : ''}`}>{w.status}</span></div>
                  <dl>
                    <div><dt>For</dt><dd>{w.who}</dd></div>
                    <div><dt>You need</dt><dd>{w.need}</dd></div>
                    <div><dt>You get</dt><dd>{w.get}</dd></div>
                  </dl>
                  <span class="way-go">Read the guide <Icon name="ArrowRight" size={16} /></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="faq" class="sec">
        <div class="wrap narrow">
          <h2>Questions.</h2>
          <Faq client:visible items={faq} />
        </div>
      </section>

      <section class="sec final">
        <div class="wrap final-grid">
          <div class="final-copy">
            <h2 class="giant">Make your TV<br />feel new.</h2>
            <div class="final-actions">
              <a class="pill primary" href={install}><span class="chip"><Icon name="DownloadSimple" size={18} /></span>Get Glass</a>
            </div>
          </div>
          <div class="final-side">
            <div class="tv-frame small"><Slot client:visible media={m.fin} alt="Glass home screen loop" todo="final loop" w={1920} h={1080} format="webm+mp4" /></div>
            <div class="qr">
              <div class="qr-img" role="img" aria-label="QR code linking to the Glass install page" set:html={qr} />
              <p>Scan to open the install page on your phone.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <a href={`${base}/`} aria-label="Glass home"><Logo /></a>
        <nav aria-label="Footer">
          <a href={`${base}/overview/`}>Docs</a>
          <a href={install}>Install</a>
          <a href={`${base}/troubleshooting/`}>Troubleshooting</a>
          <a href={repo}>GitHub</a>
        </nav>
        <p>2026 Glass. Open source under Apache-2.0. Not affiliated with Apple, Amazon or Google.</p>
      </div>
    </footer>

    <script is:inline>
      // Primary pill: the hover fill enters from the side the pointer came from.
      document.querySelectorAll('.pill').forEach((el) => el.addEventListener('pointerenter', (e) => {
        const r = el.getBoundingClientRect(); el.style.setProperty('--ox', ((e.clientX - r.left) / r.width * 100) + '%');
      }));
    </script>
  </body>
</html>
