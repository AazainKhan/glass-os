---
import '../styles/tokens.css';
import '../styles/landing.css';
import Nav from '../components/Nav.astro';
import Icon from '../components/Icon.tsx';
import Logo from '../components/Logo.tsx';
import { media } from '../lib/media';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const install = `${base}/install/`;
const repo = 'https://github.com/AazainKhan/glass-tv-launcher';

const ways = [
  { name: 'APK', note: 'Sideload the app. No root. On Fire TV, one adb command makes it the real home screen.', status: 'Available', href: `${base}/install/app/` },
  { name: 'Glass Pro (rooted)', note: 'One Magisk zip: Glass as a system app, hold-Home pairing, remote buttons, Control Center over apps.', status: 'Coming soon', href: `${base}/install/rooted/` },
  { name: 'Glass OS', note: 'A rebuilt Fire OS with Glass built in.', status: 'In development', href: `${base}/install/full-system/` },
];

const stills = [
  { m: media('preview-3'), t: 'Cover Flow', d: 'Spotify covers in the Top Shelf become a Cover Flow of your albums and playlists.' },
  { m: media('preview-2'), t: 'App switcher', d: 'Recent apps as cards. Press up to close one.' },
  { m: media('preview-4'), t: 'Customizable Control Center', d: 'Opens in about 200 ms. Add, remove and resize its controls from Settings.' },
];

const more = [
  { t: 'Info with the cast.', d: 'Press Info on a Top Shelf title for cast photos, director, writers and seasons.', tag: 'Today' },
  { t: 'Pair a remote by holding Home.', d: 'Hold Home for 10 seconds, as on Apple TV. The Remotes panel in Control Center shows what Glass sees.', tag: 'Glass Pro' },
  { t: 'AirPlay.', d: 'Built-in AirPlay is coming. Today the separate PhairPlay receiver does it, switched on from Control Center.', tag: 'Coming' },
  { t: 'Downloads and Sonos.', d: 'A downloads shelf and Sonos control are being built.', tag: 'Coming' },
];

const faq = [
  { q: 'Which devices does it run on?', a: 'Glass needs Android 9 or newer. It is tested on the Fire TV Stick 4K (2nd gen) only. Other Fire TV, Android TV and Google TV devices should work, but nobody has verified that yet.' },
  { q: 'Does it replace Fire\u2019s home screen?', a: 'Once you set it as home. Fire OS has no default picker, so Glass either brings itself back over Amazon\u2019s home or one adb command disables Amazon\u2019s launcher. Your apps are untouched.' },
  { q: 'Does it show ads or track me?', a: 'Glass shows no ads and needs no account. The app has no analytics or tracking libraries. It only contacts the services behind its features: your featured shelf source, weather, Aerial videos and GitHub for updates.' },
  { q: 'What permissions does it need?', a: 'Everything works without the optional grants. They are one adb command each: secure settings for the screensaver, usage access for the full recent-apps list, and location for the Wi-Fi name.' },
  { q: 'How does it update?', a: 'Inside the app, from GitHub Releases. Android asks before each install.' },
  { q: 'How do I undo it?', a: 'Turn off Home Button Takeover and uninstall. If you disabled Amazon\u2019s launcher, run adb shell pm enable com.amazon.tv.launcher first.' },
];

const hero = media('featured');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Glass: tvOS on your Fire TV</title>
    <meta name="description" content="tvOS on your Fire TV. Glass is a free, open-source home screen with Top Shelf, Cover Flow and a fast Control Center, built for the remote." />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href={`${base}/llms.txt`} title="llms.txt" />
  </head>
  <body>
    <Nav />
    <main>
      <section class="hero lean" id="top">
        <div class="wrap lean-grid">
          <div class="lean-text">
            <h1>tvOS on your Fire TV.</h1>
            <p class="hero-sub">Glass is a free, open-source home screen with Apple TV&rsquo;s look: Top Shelf, Cover Flow and a Control Center that opens in about 200 ms. Sideload it in a minute.</p>
            <div class="hero-actions"><a class="pill primary" href={install}><span class="chip"><Icon name="DownloadSimple" size={18} /></span>Get Glass</a></div>
            <p class="fine">Tested on a Fire TV Stick 4K (2nd gen). Free, Apache-2.0.</p>
          </div>
          <div class="tv-frame lean-shot">
            <picture>
              {hero.avifSet && <source type="image/avif" srcset={hero.avifSet} sizes="(min-width: 900px) 60vw, 100vw" />}
              <img src={hero.image} srcset={hero.webpSet} sizes="(min-width: 900px) 60vw, 100vw" width="1920" height="1080" alt="The Glass home screen on a Fire TV: a Top Shelf title over a shelf of titles" fetchpriority="high" decoding="async" />
            </picture>
          </div>
        </div>
      </section>

      <section id="try" class="sec">
        <div class="wrap">
          <h2>The look, the speed.</h2>
          <p class="sub">Focus lift, tilt and panel timings follow tvOS, tuned so a Fire TV Stick keeps up. Measured on a Fire TV Stick 4K (2nd gen): under 1% janky frames.</p>
          <ul class="stills">
            {stills.map((x) => (
              <li>
                <img srcset={x.m.webpSet} sizes="(min-width: 900px) 33vw, 100vw" src={x.m.image} width="1920" height="1080" alt={x.t} loading="lazy" decoding="async" />
                <h3>{x.t}</h3><p>{x.d}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="features" class="sec">
        <div class="wrap">
          <h2>More than a skin.</h2>
          <ul class="fix-list">
            {more.map((f) => (
              <li><div><h3>{f.t}</h3><p>{f.d}</p></div><span class="tag">{f.tag}</span></li>
            ))}
          </ul>
        </div>
      </section>

      <section id="ways" class="sec">
        <div class="wrap">
          <h2>Three ways to get Glass.</h2>
          <p class="sub">Start with the APK.</p>
          <ul class="more">
            {ways.map((w, i) => (
              <li><a href={w.href}><span class="more-name">{w.name}</span><span class="more-note">{w.note}</span><span class={`tag ${i === 0 ? 'rec' : ''}`}>{w.status}</span></a></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="sec know">
        <div class="wrap">
          <h2>What to know first.</h2>
          <ul class="upfront">
            <li><strong>Tested on one stick.</strong>The Fire TV Stick 4K (2nd gen). Others should work. <a href={`${repo}/issues/new?template=device_report.yml`}>Tell us how it runs</a>.</li>
            <li><strong>Some extras need root.</strong>Hold-Home pairing, remote buttons and Control Center over apps are part of Glass Pro.</li>
            <li><strong>Independent.</strong>Not affiliated with Apple, Amazon or Google.</li>
          </ul>
        </div>
      </section>

      <section id="faq" class="sec">
        <div class="wrap narrow">
          <h2>Questions.</h2>
          <div class="qa">
            {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
          </div>
        </div>
      </section>

      <section class="sec final">
        <div class="wrap">
          <h2 class="giant">tvOS on your<br />Fire TV.</h2>
          <div class="final-actions"><a class="pill primary" href={install}><span class="chip"><Icon name="DownloadSimple" size={18} /></span>Get Glass</a></div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <a href={`${base}/`} aria-label="Glass home"><Logo /></a>
        <nav aria-label="Footer">
          <a href={`${base}/overview/`}>Docs</a>
          <a href={install}>Install</a>
          <a href={`${base}/troubleshooting/`}>Troubleshooting</a>
          <a href={repo}>GitHub</a>
        </nav>
        <p>2026 Glass. Open source under Apache-2.0. Not affiliated with Apple, Amazon or Google.</p>
      </div>
    </footer>

  </body>
</html>
